{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "タイムラインイベント スキーマ",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "chapter", "description", "characters"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "chapter": { "type": "integer", "minimum": 1 },
      "chapter_title": { "type": ["string", "null"] },
      "chapter_order": { "type": "integer", "minimum": 1 },
      "source_id": { "type": "string", "minLength": 1 },
      "source_locator": { "type": "object", "required": ["chapter", "pages", "scene_id"], "properties": {
        "chapter": { "type": "integer", "minimum": 1 },
        "pages": { "type": ["array", "null"], "items": { "type": "integer", "minimum": 1 } },
        "scene_id": { "type": "string", "minLength": 1 }
      } },
      "verification_status": { "type": "string", "enum": ["review_recorded", "unverified", "hypothesis"] },
      "location_status": { "type": "string", "enum": ["recorded", "unverified", "original_unknown", "not_applicable"] },
      "location_basis": { "type": "string" },
      "time_inference": { "type": "boolean", "description": "falseなら前後のイベントから時計時刻を自動補間しない" },
      "time_before_event_id": { "type": "string", "description": "時計時刻を与えず、明示された後続イベントより前に並べる" },
      "time_after_event_id": { "type": "string", "description": "時計時刻を与えず、先行イベントより後に並べる" },
      "period": { "type": "string", "enum": ["preboard", "ritual"] },
      "relative_days_before_departure": { "type": "integer", "minimum": 0 },
      "day": { "type": ["integer", "null"] },
      "date_certainty": { "type": "string", "enum": ["confirmed", "estimated", "provisional", "unknown"] },
      "is_estimate": { "type": "boolean" },
      "time_start": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
      "time_estimate": { "type": "string", "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
      "time_estimate_basis": { "type": "string", "description": "仮時刻の根拠となるsources.jsonの出典ID。原作時計による確定時刻とは区別する" },
      "time_end": { "type": ["string", "null"], "pattern": "^[0-2][0-9]:[0-5][0-9]$" },
      "type": { "type": ["string", "null"] },
      "description": { "type": "string", "minLength": 1 },
      "title": {"type":"string","minLength":1},
      "summary": {"type":"string","minLength":1},
      "characters": { "type": "array", "items": { "type": "string" } },
      "character_presence": {"type":"object", "description":"関係人物とは別。在室・遺体・話題のみ・遠隔・未判定。内容の確認状態はverification_statusに従う", "additionalProperties":{"enum":["present","body","mentioned","remote","unknown"]}},
      "status_effects": {"type":"array","items":{"type":"object","required":["character","status"],"properties":{"character":{"type":"string"},"status":{"type":"string"}}}},
      "character_locations": {
        "type": "object",
        "additionalProperties": { "type": ["string", "null"] }
      },
      "chronology_kind": { "type": "string", "enum": ["event", "flashback", "reference", "setting", "unknown"] },
      "room": { "type": ["string", "null"] },
      "location": { "type": ["string", "null"] },
      "camp": { "type": ["array", "null"], "items": { "type": "string" } },
      "series": { "type": ["string", "null"] },
      "series_index": { "type": ["integer", "null"] },
      "revealed_facts": { "type": "array", "items": { "type": "string" } },
      "mysteries": { "type": "array", "items": { "type": "string" } },
      "editorial_questions": {"type":"array","items":{"type":"string","minLength":1},"description":"日時や出典などの編集上の確認課題。作品内の謎とは分ける"},
      "mystery_updates": {"type":"array","items":{"type":"object","required":["text","status","related_event_ids"],"additionalProperties":false,"properties":{"text":{"type":"string"},"status":{"enum":["unreviewed","open","resolved"]},"related_event_ids":{"type":"array","items":{"type":"string"},"minItems":1,"uniqueItems":true},"review_note":{"type":"string"}}}},
      "notes": { "type": ["string", "null"] },
      "reference_images": {
        "type": "array",
        "items": { "type": "object", "required": ["image", "caption"], "properties": {
          "image": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1 }
        } }
      }
    }
  }
}
