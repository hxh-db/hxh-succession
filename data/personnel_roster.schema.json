{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "type": "object",
  "required": ["version", "initial_total", "members", "later", "identity_pools", "queen_projections"],
  "properties": {
    "version": {"const": 1},
    "initial_total": {"const": 230},
    "scope": {"type": "string"},
    "members": {"type": "array", "minItems": 230, "maxItems": 230, "items": {"$ref": "#/definitions/member"}},
    "later": {"type": "array", "items": {"$ref": "#/definitions/member"}},
    "identity_pools": {"type": "array", "items": {"type": "object", "required": ["id", "character_ids", "queen_ranks"], "properties": {
      "id": {"type": "string"}, "character_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string"}},
      "queen_ranks": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 7}}
    }}},
    "queen_projections": {"type": "array", "items": {"type": "object", "required": ["character_id", "queen_rank", "pool_id"], "properties": {
      "character_id": {"type": "string"}, "queen_rank": {"type": "integer", "minimum": 1, "maximum": 7}, "pool_id": {"type": "string"}
    }}}
  },
  "definitions": {
    "member": {"type": "object", "required": ["character_id", "initial", "queen_rank", "prince_ranks", "basis", "history"], "properties": {
      "character_id": {"type": "string", "minLength": 1}, "slot_id": {"type": "string"}, "initial": {"type": "boolean"},
      "queen_rank": {"type": ["integer", "null"], "minimum": 1, "maximum": 8},
      "prince_ranks": {"type": "array", "uniqueItems": true, "items": {"type": "integer", "minimum": 1, "maximum": 14}},
      "observed_from": {"type": ["integer", "null"], "minimum": 1}, "basis": {"type": "string"},
      "history": {"type": "array", "items": {"type": "object", "required": ["chapter"], "properties": {
        "chapter": {"type": "integer", "minimum": 1}, "status": {"type": "string"}, "assignment": {"type": "string"}, "event_id": {"type": "string"}
      }}}
    }}
  }
}
