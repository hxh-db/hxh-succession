{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "未解決事項一覧",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "title", "category", "known", "unknown", "related_event_ids", "status", "last_checked_chapter"],
    "properties": {
      "id": { "type": "string", "pattern": "^Q[0-9]{3}$" },
      "title": { "type": "string", "minLength": 1 },
      "category": { "type": "string", "enum": ["事件", "念・能力", "王族・継承", "儀式・制度"] },
      "known": { "type": "string", "minLength": 1 },
      "unknown": { "type": "string", "minLength": 1 },
      "related_event_ids": { "type": "array", "minItems": 1, "items": { "type": "string" }, "uniqueItems": true },
      "status": { "type": "string", "enum": ["open", "resolved"] },
      "last_checked_chapter": { "type": "integer", "minimum": 1 }
    }
  }
}
