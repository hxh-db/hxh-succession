{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "王子間の共闘",
  "type": "object", "required": ["version", "alliances"],
  "properties": {
    "version": {"const": 1},
    "alliances": {"type": "array", "items": {
      "type": "object", "required": ["id", "name", "prince_ids", "cooperator_ids", "evidence_event_ids"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "name": {"type": "string", "minLength": 1},
        "prince_ids": {"type": "array", "minItems": 2, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "cooperator_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "evidence_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string", "minLength": 1}},
        "camp_names": {"type": "array", "items": {"type": "string", "minLength": 1}},
        "purpose": {"type": "string"},
        "notes": {"type": "string"}
      }
    }}
  }
}
