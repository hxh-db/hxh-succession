{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "人物タグと割当",
  "type": "object",
  "required": ["version", "definitions", "assignments"],
  "properties": {
    "version": {"const": 1},
    "definitions": {"type": "array", "items": {
      "type": "object", "required": ["id", "category", "label"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "category": {"type": "string", "minLength": 1},
        "label": {"type": "string", "minLength": 1}
      }
    }},
    "assignments": {"type": "array", "items": {
      "type": "object", "required": ["character_id", "tag_ids"],
      "properties": {
        "character_id": {"type": "string", "minLength": 1},
        "tag_ids": {"type": "array", "uniqueItems": true, "items": {"type": "string", "minLength": 1}}
      }
    }}
  }
}
