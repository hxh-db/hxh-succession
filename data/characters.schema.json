{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "キャラクター一覧 スキーマ",
  "type": "array",
  "items": {
    "type": "object",
    "required": ["id", "type", "name", "status", "is_hunter"],
    "properties": {
      "id": { "type": "string", "minLength": 1 },
      "type": {
        "type": "string",
        "enum": ["king", "prince", "queen", "hunter", "soldier", "attendant", "mercenary", "expedition_member", "mafia", "phantom_troupe", "official", "unclassified"]
      },
      "position_code": { "type": ["string", "null"] },
      "current_assignment": { "type": ["string", "null"] },
      "rank": { "type": ["integer", "null"], "minimum": 1, "maximum": 14 },
      "name": { "type": "string", "minLength": 1 },
      "display_name": { "type": "string", "minLength": 1 },
      "aliases": { "type": "array", "items": { "type": "string" }, "uniqueItems": true },
      "setting_only": { "type": "boolean", "description": "作者設定資料では確認済みだが原作の個別の顔と未照合。兵力・現在の配置へ加算しない" },
      "author_setting": {
        "type": "object",
        "required": ["source_id", "name_in_sheet", "slot", "confirmed_fields", "body_mapping", "scope"],
        "additionalProperties": false,
        "properties": {
          "source_id": { "type": "string", "minLength": 1 },
          "name_in_sheet": { "type": "string", "minLength": 1 },
          "slot": { "type": "string", "minLength": 1 },
          "confirmed_fields": { "type": "array", "minItems": 1, "uniqueItems": true, "items": { "enum": ["氏名", "顔", "私設兵分類", "兵隊長"] } },
          "body_mapping": { "enum": ["matched", "unmatched"] },
          "scope": { "type": "string", "minLength": 1 },
          "correction": { "type": "string" }
        }
      },
      "gender": { "type": ["string", "null"], "enum": ["男性", "女性", "不明", null] },
      "age": { "type": ["integer", "null"], "minimum": 0 },
      "affiliation": { "type": ["string", "null"] },
      "queen": { "type": ["string", "null"] },
      "camp": { "type": ["string", "null"] },
      "children": { "type": "array", "items": { "type": "string" } },
      "parent_ids": { "type": "array", "items": { "type": "string" } },
      "nominal_parent_relations": { "type": "array", "items": { "type": "object", "required": ["id", "chapter", "clarified_chapter", "note"], "additionalProperties": false, "properties": {
        "id": { "type": "string" }, "chapter": { "type": "integer", "minimum": 1 }, "clarified_chapter": { "type": "integer", "minimum": 1 }, "note": { "type": "string", "minLength": 1 }
      } }, "description": "名義上の親子関係。現在の人物との実際の血縁を確定するparent_idsへ混ぜない" },
      "mission": { "type": ["string", "null"] },
      "target": { "type": ["string", "null"] },
      "role": { "type": ["string", "null"] },
      "role_evidence": { "type": "string", "minLength": 1, "description": "個別の役割・兵種を確認した話数と場面、または断定できない範囲" },
      "is_count_only": { "type": "boolean", "description": "個人確認のない人数枠。現在の初期名簿に含まれる枠は個人未同定と明示して一覧・索引へ表示し、サイトマップでは推薦しない" },
      "room": { "type": ["string", "null"] },
      "initial_room": { "type": ["string", "null"], "description": "台帳の当初の担当居室。現在地ではなく、所属・任務対象から別の居室へ飛躍しない" },
      "initial_room_basis": { "type": "string", "description": "初期担当居室の根拠・未確認範囲" },
      "location": { "type": ["string", "null"] },
      "location_basis_chapter": { "type": ["integer", "null"], "minimum": 1 },
      "location_certainty": { "type": "string", "enum": ["confirmed", "estimated", "provisional", "unknown"] },
      "nen_type": { "type": ["string", "null"] },
      "nen_type_detail": { "type": ["string", "null"], "description": "条件によって系統が変わる場合の表示。nen_typeは通常時の分類" },
      "nen_ability": { "type": ["string", "null"], "description": "能力の効果・発動条件・制約・本人の仮説（仮説である旨を明記）。旧記載の扱い・判読状況・出典確認の状況などの編集上の注記は nen_ability_editorial に書く" },
      "nen_ability_editorial": { "type": ["string", "null"], "description": "nen_ability についての編集上の注記（旧記載の読みを採用しない理由、画像での判読状況、出典未確認、未整理の点など）。画面では『編集状況』に表示する" },
      "nen_user": { "type": "boolean", "description": "既存の能力記述だけでは本人の念使用が確定しない場合の表示判定" },
      "nen_status": { "type": "string", "enum": ["confirmed", "unknown", "unavailable_confirmed", "not_awakened_confirmed"], "description": "本人の念使用の確認状態。旧nen_user=falseを使用不可とみなさない" },
      "nen_status_chapter": { "type": "integer", "minimum": 1 },
      "nen_status_basis": { "type": "string" },
      "nen_history": {
        "type": "array", "minItems": 1,
        "description": "その話数までに読者へ判明した能力情報。作中の習得時点とは別。各項目は表示可能な情報全体を持つ。未整備の話数は未整理のままにする。",
        "items": {
          "type": "object", "additionalProperties": false,
          "required": ["chapter", "nen_status", "nen_type", "nen_ability_name", "nen_ability", "basis", "source_event_ids"],
          "properties": {
            "chapter": {"type": "integer", "minimum": 1},
            "nen_status": {"enum": ["confirmed", "unknown", "unavailable_confirmed", "not_awakened_confirmed"]},
            "nen_type": {"type": ["string", "null"]},
            "nen_ability_name": {"type": ["string", "null"]},
            "nen_ability": {"type": ["string", "null"]},
            "basis": {"type": "string", "minLength": 1},
            "source_event_ids": {"type": "array", "minItems": 1, "uniqueItems": true, "items": {"type": "string"}}
          }
        }
      },
      "fact_history": {
        "type":"array", "minItems":1,
        "description":"読者に確認できた話数に基づく人物属性の追記・更新。氏名・顔とは分離し、未整理の最新属性を過去へコピーしない。",
        "items":{
          "type":"object","additionalProperties":false,"required":["chapter","values","basis","source_event_ids"],
          "properties":{
            "chapter":{"type":"integer","minimum":1},
            "basis":{"type":"string","minLength":1},
            "source_event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}},
            "values":{"type":"object","minProperties":1,"additionalProperties":false,"properties":{
              "type":{"anyOf":[{"$ref":"#/items/properties/type"},{"type":"null"}]},
              "is_hunter":{"type":["boolean","null"]},
              "soldier_category":{"type":["string","null"]},"affiliation":{"type":["string","null"]},
              "camp":{"type":["string","null"]},"queen":{"type":["string","null"]},
              "role":{"type":["string","null"]},"mission":{"type":["string","null"]},"target":{"type":["string","null"]},
              "room":{"type":["string","null"]},"initial_room":{"type":["string","null"]},"current_assignment":{"type":["string","null"]},
              "parent_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
              "children":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
              "known_half_sibling_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
              "known_sibling_ids":{"type":"array","uniqueItems":true,"items":{"type":"string"}},
              "public_mother_id":{"type":["string","null"]},"reported_biological_mother_id":{"type":["string","null"]},
              "suggested_father_id":{"type":["string","null"]},"suggested_child_id":{"type":["string","null"]},
              "nen_role":{"enum":["soemono",null]}
            }}
          }
        }
      },
      "former_affiliations": { "type": "array", "items": { "type": "string" } },
      "assignment_history": { "type": "array", "items": { "type": "object", "required": ["label", "prince_id", "room", "chapter"], "properties": { "label": { "type": "string" }, "prince_id": { "type": "string" }, "room": { "type": "string" }, "chapter": { "type": "integer", "minimum": 1 }, "event_id": { "type": "string" } } } },
      "nen_origin": { "type": "string", "enum": ["nen_class", "prior", "unknown"], "description": "念講習での目覚めと、それ以前からの念能力者を区別する" },
      "nen_role": { "type": "string", "enum": ["soemono"], "description": "本人の念使用とは独立した、原作で確認された念に関する役割" },
      "nen_ability_name": { "type": ["string", "null"] },
      "nen_ability_image": { "type": ["string", "null"] },
      "nen_ability_image_source": { "type": ["string", "null"] },
      "spirit_beast_name": { "type": ["string", "null"] },
      "status": { "type": "string", "minLength": 1 },
      "status_log": { "type": "array", "items": {"type":"object", "properties": {
        "chapter":{"type":["integer","null"]}, "status":{"type":"string"}, "event_id":{"type":"string"}, "cause":{"type":["string","null"]}
      }} },
      "status_review_note": {"type":"string", "description":"状態の確認話数等に競合がある場合の保留理由"},
      "review_claims": {"type":"array", "items":{"type":"object", "required":["text","event_ids"], "additionalProperties":false, "properties":{
        "text":{"type":"string","minLength":1}, "event_ids":{"type":"array","minItems":1,"uniqueItems":true,"items":{"type":"string"}}
      }}},
      "is_hunter": { "type": "boolean" },
      "faction_note": { "type": ["string", "null"] },
      "notes": { "type": ["string", "null"] },
      "spoiler_notes": { "type": ["string", "null"] },
      "image": { "type": ["string", "null"] },
      "is_identity_reference": { "type": "boolean", "description": "名前付き人物との対応が未確定な顔の同定用レコード。兵力総数に別人として加算しない" },
      "reference_images": {
        "type": "array",
        "items": { "type": "object", "required": ["image", "caption"], "properties": {
          "image": { "type": "string", "minLength": 1 },
          "caption": { "type": "string", "minLength": 1 }
        } }
      }
      ,"is_placeholder": { "type": "boolean" }
      ,"identity_status": { "type": "string", "enum": ["named", "unnamed_confirmed", "provisional"] }
      ,"source_chapter": { "type": ["integer", "null"], "minimum": 1 }
      ,"group_key": { "type": ["string", "null"] }
    }
  }
}
